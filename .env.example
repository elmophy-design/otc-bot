ENV=development
TELEGRAM_BOT_TOKEN=your_bot_token_here
POCKETOPTION_SSID=42["auth",{"session":"YOUR_SESSION","isDemo":1,"uid":YOUR_UID,"platform":1}]
POCKETOPTION_USER_ID=your_user_id_here
DEMO_MODE=false
MIN_CONFIDENCE=70
USE_AI=false
DATABASE_URL=sqlite:///data/bot.db
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
DEBUG=false


# --- How to get POCKETOPTION_SSID ---
# 1. Log into PocketOption in your browser
# 2. Open DevTools (F12) → Network → WS (WebSocket)
# 3. Find the message starting with: 42["auth",{...}]
# 4. Copy the FULL message into POCKETOPTION_SSID
# 5. Set DEMO_MODE=true until you are ready for live

# Live broker backend: auto | botv2 | native
# auto = BinaryOptionsToolsV2 if installed + SSID present, else native client
LIVE_BACKEND=auto
